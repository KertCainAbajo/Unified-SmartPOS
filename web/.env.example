# true (default): personal/demo project; legal pages, shop and receipts say so. Set to false only for a real launch.
VITE_DEMO_MODE=true
# Public legal/contact details shown in the policy pages and sign-in footer.
# Replace these before deploying the web app. These are public values, not secrets.
VITE_PLATFORM_LEGAL_NAME=
VITE_PLATFORM_SUPPORT_EMAIL=
VITE_PLATFORM_PRIVACY_EMAIL=
VITE_PLATFORM_ADDRESS=
